{
  "name": "@ggraphic/ui",
  "version": "0.1.0-alpha.1",
  "description": "ggraphic UI kit: design tokens and accessible React components for the landing, auth and app surfaces",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Movm/ggraphic.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./src/styles/components.css",
    "./editor-bridge.css": "./src/styles/editor-bridge.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node -e \"require('node:fs').cpSync('src/styles', 'dist/styles', { recursive: true })\"",
    "demo": "vite demo",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "dist",
    "src/styles",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/styles/tokens.css",
      "./styles.css": "./dist/styles/components.css",
      "./editor-bridge.css": "./dist/styles/editor-bridge.css",
      "./fonts.css": "./dist/styles/fonts.css"
    }
  }
}
