{
  "name": "@ggraphic/editor-chrome",
  "version": "0.0.0",
  "description": "ggraphic editor chrome: the sidebar shell (tab rail, flyout panel, mobile sheet) with its tokens, without the canvas editor",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Movm/ggraphic.git",
    "directory": "packages/editor-chrome"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./src/styles/chrome.css",
    "./tailwind.css": "./src/styles/tailwind.css"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node -e \"require('node:fs').cpSync('src/styles', 'dist/styles', { recursive: true })\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/styles/tokens.css",
      "./styles.css": "./dist/styles/chrome.css",
      "./tailwind.css": "./dist/styles/tailwind.css"
    }
  }
}
