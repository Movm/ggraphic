{
  "formatVersion": 1,
  "id": "studio-photo-text-panel",
  "version": 1,
  "kind": "template",
  "family": "photo-text",
  "title": {
    "en": "Photo, text panel and strip",
    "de": "Foto, Textfläche und Streifen"
  },
  "description": {
    "en": "A photo on top, a headline on the page colour and a colour strip with a call at the bottom",
    "de": "Oben ein Foto, darunter eine Headline auf der Seitenfarbe und unten ein Farbstreifen mit einem Aufruf"
  },
  "tags": {
    "tone": "loud",
    "occasions": [],
    "topics": []
