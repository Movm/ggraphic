{
  "name": "@ggraphic/templates-open",
  "version": "0.1.0-alpha.0",
  "description": "The open template pack: the Studio's starter designs as template files",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Movm/ggraphic.git",
    "directory": "packages/templates-open"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./photos": {
      "development": "./src/samples/index.ts",
      "types": "./src/samples/index.ts",
      "import": "./dist/samples/index.js",
      "default": "./dist/samples/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-samples.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ggraphic/core": "workspace:*",
    "@ggraphic/editor": "workspace:*",
    "@ggraphic/schema": "workspace:*",
    "@types/node": "^26.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./photos": {
        "types": "./dist/samples/index.d.ts",
        "import": "./dist/samples/index.js",
        "default": "./dist/samples/index.js"
      }
    }
  }
}
