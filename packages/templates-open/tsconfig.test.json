{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The tests import the editor from source, so they are checked the way the editor is.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*", "test/**/*"]
}
