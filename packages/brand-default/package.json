{
  "name": "@ggraphic/brand-default",
  "version": "0.1.0-alpha.2",
  "description": "The neutral ggraphic brand pack with its open-licensed (OFL) fonts",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Movm/ggraphic.git",
    "directory": "packages/brand-default"
  },
  "type": "module",
  "sideEffects": [
    "./src/fonts.ts",
    "./dist/fonts.js"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fonts": "./src/fonts.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@ggraphic/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./fonts": {
        "types": "./dist/fonts.d.ts",
        "import": "./dist/fonts.js",
        "default": "./dist/fonts.js"
      }
    }
  }
}
