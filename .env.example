# ggraphic Studio configuration for docker compose. Copy to .env and adjust.
# Empty values fall back to the defaults shown.

# --- Required ---------------------------------------------------------------

# Database password. Use URL-safe characters, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Network ----------------------------------------------------------------

# Port on 127.0.0.1 where Studio is reachable (http://localhost:8080).
# Put a TLS-terminating reverse proxy in front before exposing it (docs/self-hosting.md).
STUDIO_PORT=8080

# --- Accounts ---------------------------------------------------------------

# Token the first-run setup asks for (at least 16 characters). Leave empty and Studio
# prints a random one to its log at the first start (docker compose logs studio).
SETUP_TOKEN=
# The first visitor of an empty instance creates the admin account. After that, new
# accounts come only from invitation links, unless this is true. Default: false
ALLOW_REGISTRATION=
# Session cookie flag "Secure". Default: true. Chrome and Firefox accept it on
# http://localhost; set false only for plain-HTTP use in Safari. In the container Studio
# listens on 0.0.0.0, so false also needs ALLOW_INSECURE_COOKIE=1 (Studio then warns at start).
COOKIE_SECURE=
ALLOW_INSECURE_COOKIE=
# Which reverse proxies may set X-Forwarded-For (client IP for the login rate limits):
# false, a hop count (e.g. 1) or a comma-separated list of proxy addresses/subnets and
# loopback, linklocal, uniquelocal (e.g. loopback,10.0.0.0/8). "true" is refused: it would
# let every client choose its own address. Default: false
TRUST_PROXY=

# --- Limits (bytes) ---------------------------------------------------------

# Maximum size of one image upload. Default: 10485760 (10 MB)
UPLOAD_MAX_BYTES=
# Maximum size of a project thumbnail (PNG). Default: 2097152 (2 MB)
THUMBNAIL_MAX_BYTES=
# Maximum size of a JSON request, i.e. of one saved document. Default: 5242880 (5 MB)
DOCUMENT_MAX_BYTES=
# Maximum size of one brand font file (WOFF2, TTF, OTF). Default: 5242880 (5 MB)
FONT_MAX_BYTES=

# --- Tools that need an outside service (optional) -------------------------
# Every such tool is on when its key or URL is set. <TOOL>_ENABLED=false turns
# a configured tool off; <TOOL>_ENABLED=true without its key or URL stops the
# server at start.

# --- AI drafts (optional) ---------------------------------------------------
# Any OpenAI-compatible chat completions API. AI is switched off unless all
# three of OPENAI_BASE_URL, OPENAI_API_KEY and OPENAI_MODEL are set.
# Examples are in docs/self-hosting.md (Mistral, Ollama, LiteLLM).

# Base URL up to and including /v1, e.g. https://api.mistral.ai/v1
OPENAI_BASE_URL=
# API key, sent as "Authorization: Bearer <key>". For Ollama use any value, e.g. ollama.
OPENAI_API_KEY=
# Model name as the provider expects it, e.g. mistral-small-latest
OPENAI_MODEL=
# Timeout for one AI request in milliseconds. Default: 60000
AI_TIMEOUT_MS=
# false switches AI off although the three values above are set.
AI_ENABLED=

# --- Only when running the server without docker compose ---------------------
# DATABASE_URL=postgres://studio:<password>@127.0.0.1:5432/studio
# HOST=127.0.0.1
# PORT=8080
# DATA_DIR=apps/studio-server/data   (uploads in $DATA_DIR/uploads, logos and fonts in $DATA_DIR/brand-assets)
# STATIC_DIR=apps/studio/dist        (built web app; API only if missing)
