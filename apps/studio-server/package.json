{
  "name": "@ggraphic/studio-server",
  "version": "0.1.0-alpha.6",
  "private": true,
  "description": "ggraphic Studio backend: projects, uploads and AI drafts for self-hosting",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ggraphic/ai": "workspace:*",
    "@ggraphic/core": "workspace:*",
    "@ggraphic/schema": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
